{
    "name": "lspskript",
    "displayName": "LspSkript",
    "description": "Full Skript language support (diagnostics, completion, hover, definitions, rename) powered by Skript's real parser.",
    "version": "0.1.0",
    "publisher": "RohanDaCoder",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "format": "bun fmt",
        "format:check": "bun fmt --check",
        "lint": "bun lint",
        "typecheck": "bun check",
        "verify": "bun run typecheck && bun run lint && bun run format:check",
        "vscode:prepublish": "bun run build",
        "build": "bun run verify && bun run grammar && bun build extension.ts --bundle --outfile=dist/extension.js --platform=node --target=node --format=cjs --external vscode",
        "grammar": "bun run scripts/copy-grammar.ts",
        "package": "vsce package --allow-missing-repository",
        "package:vsix": "bun run build && bunx @vscode/vsce package --allow-missing-repository -o lspskript.vsix",
        "install:vsix": "bun run package:vsix && code --install-extension lspskript.vsix --force"
    },
    "contributes": {
        "languages": [
            {
                "id": "skript",
                "aliases": [
                    "Skript",
                    "skript"
                ],
                "extensions": [
                    ".sk"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "skript",
                "scopeName": "source.skript",
                "path": "./syntaxes/skript.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Skript LSP",
            "properties": {
                "skriptLsp.host": {
                    "type": "string",
                    "default": "localhost",
                    "description": "Host the LspSkript plugin is listening on."
                },
                "skriptLsp.port": {
                    "type": "number",
                    "default": 30505,
                    "description": "TCP port the LspSkript plugin is listening on."
                },
                "skriptLsp.trace": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "LSP message tracing level."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "@types/node": "^24.0.0",
        "@types/vscode": "^1.75.0",
        "@vscode/vsce": "^3.9.2",
        "cson-parser": "^4.0.9"
    }
}
